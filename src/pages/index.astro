---
/**
 * Página Principal - La Casa del Poeta
 */

import Layout from '../layouts/Layout.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { testimonials, culturalEvents, includedServices } from '../data/rooms';
import { siteContent } from '../data/content';
import { images } from '../data/images';

const base = import.meta.env.BASE_URL;
const whatsappLink = `https://wa.me/${siteContent.whatsappNumber}`;
const heroImageWebP = images.hero.replace(/\.(jpg|jpeg|png)$/i, '.webp');
---

<Layout>
  
  <!-- Hero Section -->
  <section class="relative h-screen flex items-center justify-center text-white overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-terracota-900/80 via-terracota-800/70 to-sage-900/80 z-10"></div>
    <picture>
      <source srcset={heroImageWebP} type="image/webp" />
      <img 
        src={images.hero}
        alt={siteContent.siteName}
        class="absolute inset-0 w-full h-full object-cover animate-slow-zoom"
        fetchpriority="high"
        loading="eager"
        decoding="async"
      />
    </picture>
    
    <div class="relative z-20 text-center px-6 max-w-5xl animate-fade-in">
      <h1 class="text-6xl md:text-8xl font-display font-extrabold mb-8 leading-tight drop-shadow-2xl">
        {siteContent.hero.title}
      </h1>
      <p class="text-2xl md:text-3xl mb-6 font-light drop-shadow-lg">
        {siteContent.hero.subtitle}
      </p>
      <p class="text-lg md:text-xl mb-10 max-w-3xl mx-auto opacity-95">
        {siteContent.hero.description}
      </p>
      <div class="flex flex-col sm:flex-row gap-5 justify-center">
        <a 
          href={`${base}/habitaciones`}
          class="group bg-white text-terracota-600 px-10 py-5 rounded-2xl text-lg font-bold transition-all shadow-xl hover:shadow-2xl hover:scale-105 hover:-translate-y-1"
        >
          {siteContent.hero.ctaButton}
        </a>
        <a 
          href={whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-gradient-to-r from-green-500 to-green-600 hover:from-green-600 hover:to-green-700 text-white px-10 py-5 rounded-2xl text-lg font-bold transition-all shadow-xl hover:shadow-2xl hover:scale-105 hover:-translate-y-1"
        >
          {siteContent.hero.whatsappButton}
        </a>
      </div>
    </div>
  </section>

  <!-- Servicios Incluidos -->
  <section class="py-24 bg-gradient-to-br from-white to-gray-50">
    <div class="container mx-auto px-6">
      <div class="text-center mb-16 animate-slide-up">
        <h2 class="text-5xl font-display font-bold text-gray-900 mb-6">
          {siteContent.services.title}
        </h2>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">
          {siteContent.services.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {includedServices.map((service) => (
          <ServiceCard 
            icon={service.icon}
            name={service.name}
            description={service.description}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Eventos Culturales -->
  <section class="py-24 bg-gradient-to-br from-sage-50/40 to-terracota-50/20">
    <div class="container mx-auto px-6">
      <div class="text-center mb-16">
        <h2 class="text-5xl font-display font-bold text-gray-900 mb-6">
          {siteContent.culturalEvents.title}
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          {siteContent.culturalEvents.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 max-w-5xl mx-auto">
        {culturalEvents.map((event) => {
          const eventImageWebP = event.image ? event.image.replace(/\.(jpg|jpeg|png)$/i, '.webp') : null;
          return (
            <div class="group bg-white rounded-3xl overflow-hidden shadow-medium hover:shadow-xl transition-all duration-500 hover:-translate-y-2">
              {event.image && (
                <picture>
                  <source srcset={eventImageWebP} type="image/webp" />
                  <img 
                    src={event.image} 
                    alt={event.title}
                    class="w-full h-72 object-cover group-hover:scale-110 transition-transform duration-700"
                    loading="lazy"
                    decoding="async"
                    width="600"
                    height="288"
                  />
                </picture>
              )}
            <div class="p-6">
              <span class="inline-block bg-sage-600/10 text-sage-700 px-3 py-1 rounded-full text-sm font-medium mb-3">
                {event.frequency}
              </span>
              <h3 class="text-2xl font-serif font-bold text-gray-900 mb-3">
                {event.title}
              </h3>
              <p class="text-gray-600">
                {event.description}
              </p>
            </div>
          </div>
          );
        })}
      </div>
      
      <div class="text-center mt-10">
        <a 
          href={`${base}/eventos`}
          class="inline-block bg-sage-600 hover:bg-sage-700 text-white px-8 py-3 rounded-lg font-medium transition-colors"
        >
          {siteContent.culturalEvents.ctaButton}
        </a>
      </div>
    </div>
  </section>

  <!-- Testimonios -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-4xl font-serif font-bold text-gray-900 mb-4">
          {siteContent.testimonials.title}
        </h2>
        <p class="text-lg text-gray-600">
          {siteContent.testimonials.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {testimonials.slice(0, 3).map((testimonial) => (
          <TestimonialCard 
            name={testimonial.name}
            text={testimonial.text}
            date={testimonial.date}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Ubicación Preview -->
  <section class="py-16 bg-sage-50/50">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-4xl font-serif font-bold text-gray-900 mb-6">
          {siteContent.location.title}
        </h2>
        <p class="text-lg text-gray-700 mb-8 leading-relaxed">
          {siteContent.location.description}
        </p>
        <a 
          href={`${base}/ubicacion`}
          class="inline-block bg-sage-600 hover:bg-sage-700 text-white px-8 py-3 rounded-lg font-medium transition-colors"
        >
          {siteContent.location.ctaButton}
        </a>
      </div>
    </div>
  </section>

  <!-- Call to Action Final -->
  <section class="py-20 bg-gradient-to-r from-terracota-600 to-terracota-700 text-white">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-4xl md:text-5xl font-serif font-bold mb-6">
        {siteContent.finalCta.title}
      </h2>
      <p class="text-xl mb-8 max-w-2xl mx-auto">
        {siteContent.finalCta.description}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a 
          href={whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-white text-terracota-600 hover:bg-gray-100 px-8 py-4 rounded-lg text-lg font-bold transition-colors shadow-lg"
        >
          {siteContent.finalCta.whatsappButton}
        </a>
      </div>
    </div>
  </section>

</Layout>
