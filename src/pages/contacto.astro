---
/**
 * Página de Contacto - Redirige a WhatsApp
 */

import Layout from '../layouts/Layout.astro';
import { siteContent } from '../data/content';

const whatsappLink = `https://wa.me/${siteContent.whatsappNumber}`;
---

<Layout>
  
  <section class="bg-gradient-to-r from-terracota-600 to-terracota-700 text-white py-20">
    <div class="container mx-auto px-4 text-center">
      <h1 class="text-4xl md:text-6xl font-serif font-bold mb-6">
        Contáctanos
      </h1>
      <p class="text-xl md:text-2xl max-w-3xl mx-auto">
        Estamos aquí para responder todas tus preguntas y ayudarte 
        a reservar tu estadía en {siteContent.siteName}.
      </p>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="container mx-auto px-4 max-w-4xl">
      <div class="grid md:grid-cols-2 gap-8">
        
        <!-- WhatsApp -->
        <div class="bg-green-50 p-8 rounded-lg text-center hover:shadow-lg transition-shadow">
          <div class="text-6xl mb-4">💬</div>
          <h3 class="text-2xl font-bold text-gray-900 mb-3">WhatsApp</h3>
          <p class="text-gray-600 mb-4">
            La forma más rápida de contactarnos. Respuesta inmediata.
          </p>
          <a
            href={whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block bg-green-600 hover:bg-green-700 text-white px-6 py-3 rounded-lg font-medium transition-colors"
          >
            +57 301 271 2450
          </a>
        </div>

        <!-- Instagram -->
        <div class="bg-sage-50 p-8 rounded-lg text-center hover:shadow-lg transition-shadow">
          <div class="text-6xl mb-4">📸</div>
          <h3 class="text-2xl font-bold text-gray-900 mb-3">Instagram</h3>
          <p class="text-gray-600 mb-4">
            Síguenos y envíanos mensaje directo.
          </p>
          <a
            href={siteContent.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block bg-sage-600 hover:bg-sage-700 text-white px-6 py-3 rounded-lg font-medium transition-colors"
          >
            {siteContent.instagramHandle}
          </a>
        </div>

      </div>
    </div>
  </section>

</Layout>
          </div>

          <!-- Botón enviar -->
          <div>
            <button
              type="submit"
              class="w-full bg-terracota-600 hover:bg-terracota-700 text-white px-8 py-4 rounded-lg font-bold text-lg transition-colors"
            >
              Enviar Mensaje 📨
            </button>
          </div>

          <p class="text-sm text-gray-500 text-center">
            * Campos obligatorios
          </p>
        </form>

        <!-- Nota sobre formulario -->
        <div class="mt-8 p-4 bg-yellow-50 border border-yellow-200 rounded-lg">
          <p class="text-sm text-gray-700">
            <strong>Nota:</strong> Este formulario necesita ser configurado con un servicio 
            como <a href="https://formspree.io" target="_blank" class="text-terracota-600 hover:underline">Formspree</a> 
            o similar. Por ahora, te recomendamos contactarnos directamente por WhatsApp 
            para una respuesta más rápida.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Información Adicional -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4 max-w-4xl">
      <h2 class="text-3xl font-serif font-bold text-center text-gray-900 mb-12">
        Preguntas Frecuentes
      </h2>
      
      <div class="space-y-6">
        <div class="bg-gray-50 p-6 rounded-lg">
          <h3 class="font-bold text-gray-900 mb-2 text-lg">
            ¿Cuál es el horario de check-in y check-out?
          </h3>
          <p class="text-gray-600">
            Por favor contáctanos para coordinar los horarios según tu llegada. 
            Somos flexibles y nos adaptamos a tus necesidades.
          </p>
        </div>

        <div class="bg-gray-50 p-6 rounded-lg">
          <h3 class="font-bold text-gray-900 mb-2 text-lg">
            ¿Cuánto cuesta la estadía?
          </h3>
          <p class="text-gray-600">
            Los precios varían según la habitación y duración de la estadía. 
            Contáctanos por WhatsApp para una cotización personalizada.
          </p>
        </div>

        <div class="bg-gray-50 p-6 rounded-lg">
          <h3 class="font-bold text-gray-900 mb-2 text-lg">
            ¿Aceptan estadías cortas (menos de una semana)?
          </h3>
          <p class="text-gray-600">
            Sí, aunque nos especializamos en largas estadías, también recibimos 
            huéspedes por períodos cortos según disponibilidad.
          </p>
        </div>

        <div class="bg-gray-50 p-6 rounded-lg">
          <h3 class="font-bold text-gray-900 mb-2 text-lg">
            ¿Cómo puedo reservar?
          </h3>
          <p class="text-gray-600">
            La forma más fácil es contactarnos por WhatsApp. Te daremos toda la información, 
            confirmaremos disponibilidad y te explicaremos el proceso de reserva.
          </p>
        </div>

        <div class="bg-gray-50 p-6 rounded-lg">
          <h3 class="font-bold text-gray-900 mb-2 text-lg">
            ¿Los eventos culturales tienen costo adicional?
          </h3>
          <p class="text-gray-600">
            No, todos los eventos culturales están incluidos para los huéspedes. 
            Es parte de la experiencia de vivir en La Casa del Poeta.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Call to Action Final -->
  <section class="py-16 bg-oliva-50">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-3xl md:text-4xl font-serif font-bold text-gray-900 mb-6">
        ¿Prefieres Hablar Directamente?
      </h2>
      <p class="text-xl text-gray-700 mb-8 max-w-2xl mx-auto">
        Nuestro equipo está disponible por WhatsApp para responder 
        todas tus preguntas de inmediato.
      </p>
      <a
        href="https://wa.me/573012712450"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block bg-green-600 hover:bg-green-700 text-white px-10 py-4 rounded-lg font-bold text-lg transition-colors shadow-lg"
      >
        💬 Abrir WhatsApp Ahora
      </a>
    </div>
  </section>

</Layout>
