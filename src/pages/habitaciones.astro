---
/**
 * Página de Habitaciones
 */

import Layout from '../layouts/Layout.astro';
import RoomCard from '../components/RoomCard.astro';
import ImageGallery from '../components/ImageGallery.astro';
import { rooms } from '../data/rooms';
import { siteContent } from '../data/content';

const { base } = import.meta.env;
const whatsappLink = `https://wa.me/${siteContent.whatsappNumber}`;
---

<Layout>
  
  <section class="bg-gradient-to-r from-terracota-600 to-terracota-700 text-white py-20">
    <div class="container mx-auto px-4 text-center">
      <h1 class="text-4xl md:text-6xl font-serif font-bold mb-6">
        {siteContent.rooms.title}
      </h1>
      <p class="text-xl md:text-2xl max-w-3xl mx-auto">
        {siteContent.rooms.description}
      </p>
    </div>
  </section>

  <section class="py-16 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {rooms.map((room) => (
          <RoomCard room={room} />
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="container mx-auto px-4 max-w-6xl">
      <h2 class="text-3xl font-serif font-bold text-center mb-12">
        {siteContent.rooms.galleryTitle}
      </h2>
      
      {rooms.map((room) => (
        <div id={room.id} class="mb-16 scroll-mt-20">
          <div class="bg-white rounded-lg shadow-medium p-8">
            <div class="mb-6">
              <h3 class="text-3xl font-serif font-bold text-gray-900 mb-2">
                {room.name}
              </h3>
              <p class="text-lg text-gray-600">
                {room.description}
              </p>
            </div>

            <div class="mb-6">
              <h4 class="font-bold text-gray-900 mb-3">{siteContent.rooms.features}</h4>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                {room.features.map((feature) => (
                  <div class="flex items-center text-gray-700">
                    <span class="text-terracota-600 mr-2 text-xl">✓</span>
                    <span>{feature}</span>
                  </div>
                ))}
              </div>
            </div>

            <ImageGallery 
              images={room.images} 
              videos={room.videos}
            />

            <div class="flex flex-col sm:flex-row gap-4 mt-6">
              <a
                href={`${whatsappLink}?text=Hola! Me interesa la ${room.name}. ¿Está disponible?`}
                target="_blank"
                rel="noopener noreferrer"
                class="flex-1 bg-green-600 hover:bg-green-700 text-white text-center px-6 py-3 rounded-lg transition-colors font-medium"
              >
                {siteContent.rooms.whatsappCta}
              </a>
              <a
                href={`${base}/contacto`}
                class="flex-1 bg-terracota-600 hover:bg-terracota-700 text-white text-center px-6 py-3 rounded-lg transition-colors font-medium"
              >
                📧 Enviar Consulta
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Información adicional -->
  <section class="py-16 bg-oliva-50">
    <div class="container mx-auto px-4 max-w-4xl">
      <div class="bg-white rounded-lg shadow-medium p-8">
        <h2 class="text-3xl font-serif font-bold text-gray-900 mb-6 text-center">
          Servicios Incluidos en Todas las Habitaciones
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
          <div class="flex items-start">
            <span class="text-3xl mr-4">📶</span>
            <div>
              <h3 class="font-bold text-gray-900 mb-1">WiFi de Alta Velocidad</h3>
              <p class="text-gray-600 text-sm">Internet incluido sin costo adicional</p>
            </div>
          </div>
          
          <div class="flex items-start">
            <span class="text-3xl mr-4">💡</span>
            <div>
              <h3 class="font-bold text-gray-900 mb-1">Servicios Públicos</h3>
              <p class="text-gray-600 text-sm">Agua, luz y gas incluidos</p>
            </div>
          </div>
          
          <div class="flex items-start">
            <span class="text-3xl mr-4">🚿</span>
            <div>
              <h3 class="font-bold text-gray-900 mb-1">Agua Caliente</h3>
              <p class="text-gray-600 text-sm">Disponible las 24 horas</p>
            </div>
          </div>
          
          <div class="flex items-start">
            <span class="text-3xl mr-4">🧹</span>
            <div>
              <h3 class="font-bold text-gray-900 mb-1">Servicio de Aseo</h3>
              <p class="text-gray-600 text-sm">Limpieza regular incluida</p>
            </div>
          </div>
          
          <div class="flex items-start">
            <span class="text-3xl mr-4">🎬</span>
            <div>
              <h3 class="font-bold text-gray-900 mb-1">Eventos Culturales</h3>
              <p class="text-gray-600 text-sm">Cineforos semanales y más</p>
            </div>
          </div>
          
          <div class="flex items-start">
            <span class="text-3xl mr-4">🏛️</span>
            <div>
              <h3 class="font-bold text-gray-900 mb-1">Ubicación Patrimonial</h3>
              <p class="text-gray-600 text-sm">En el corazón de San Antonio</p>
            </div>
          </div>
        </div>

        <div class="text-center pt-6 border-t">
          <p class="text-gray-700 mb-4">
            ¿Tienes preguntas sobre nuestras habitaciones o precios?
          </p>
          <a
            href="https://wa.me/573012712450"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block bg-green-600 hover:bg-green-700 text-white px-8 py-3 rounded-lg font-medium transition-colors"
          >
            Contáctanos por WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>
