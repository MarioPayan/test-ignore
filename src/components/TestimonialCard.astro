---
/**
 * Tarjeta de Testimonio
 * 
 * Muestra una reseña de un huésped.
 * 
 * Props:
 * - name: Nombre del huésped
 * - text: Texto del testimonio
 * - date: Fecha (opcional)
 */

interface Props {
  name: string;
  text: string;
  date?: string;
}

const { name, text, date } = Astro.props;
---

<div class="bg-white p-6 rounded-lg shadow-soft hover:shadow-medium transition-shadow">
  <!-- Comillas decorativas -->
  <div class="text-4xl text-terracota-300 mb-3 font-serif">"</div>
  
  <!-- Texto del testimonio -->
  <p class="text-gray-700 mb-4 italic leading-relaxed">
    {text}
  </p>
  
  <!-- Autor -->
  <div class="flex items-center justify-between">
    <div>
      <p class="font-semibold text-gray-900">{name}</p>
      {date && (
        <p class="text-sm text-gray-500">{date}</p>
      )}
    </div>
    
    <!-- Rating visual -->
    <div class="text-yellow-400 text-lg">
      ⭐⭐⭐⭐⭐
    </div>
  </div>
</div>
