---
/**
 * Tarjeta de Testimonio
 * 
 * Muestra una reseña de un huésped.
 * 
 * Props:
 * - name: Nombre del huésped
 * - text: Texto del testimonio
 * - date: Fecha (opcional)
 */

interface Props {
  name: string;
  text: string;
  date?: string;
}

const { name, text, date } = Astro.props;
---

<div class="bg-gradient-to-br from-white to-gray-50 p-8 rounded-3xl shadow-medium hover:shadow-xl transition-all duration-500 hover:-translate-y-1 border border-gray-100">
  <!-- Comillas decorativas -->
  <div class="text-5xl text-terracota-400 mb-4 font-serif leading-none">"</div>
  
  <!-- Texto del testimonio -->
  <p class="text-gray-700 mb-6 leading-relaxed">
    {text}
  </p>
  
  <!-- Autor -->
  <div class="flex items-center justify-between">
    <div>
      <p class="font-semibold text-gray-900 text-lg">{name}</p>
      {date && (
        <p class="text-sm text-gray-500 mt-1">{date}</p>
      )}
    </div>
    
    <!-- Rating visual -->
    <div class="text-amber-400 text-xl">
      ⭐⭐⭐⭐⭐
    </div>
  </div>
</div>
