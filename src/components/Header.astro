---
/**
 * Header / Navegación principal
 */

import { siteContent } from '../data/content';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: `${base}/`, label: 'Inicio' },
  { href: `${base}/habitaciones`, label: 'Habitaciones' },
  { href: `${base}/eventos`, label: 'Eventos Culturales' },
  { href: `${base}/nosotros`, label: 'Nosotros' },
  { href: `${base}/ubicacion`, label: 'Ubicación' },
  { href: `${base}/contacto`, label: 'Contacto' },
];

const whatsappLink = `https://wa.me/${siteContent.whatsappNumber}`;
---

<header class="bg-white/80 backdrop-blur-xl shadow-soft sticky top-0 z-50 border-b border-gray-100">
  <nav class="container mx-auto px-6 py-2">
    <div class="flex items-center justify-between">
      <a href={`${base}/`} class="flex items-center space-x-2 group">
        <span class="text-2xl lg:text-3xl font-display font-bold text-terracota-600 group-hover:text-terracota-700 transition-colors">
          {siteContent.siteName}
        </span>
      </a>

      <!-- Menú Desktop -->
      <div class="hidden md:flex items-center space-x-8">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class={`font-medium transition-all text-sm lg:text-base ${
              currentPath === link.href
                ? 'text-terracota-600 scale-105'
                : 'text-gray-700 hover:text-terracota-600 hover:scale-105'
            }`}
          >
            {link.label}
          </a>
        ))}
        
        <a
          href={whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-gradient-to-r from-terracota-500 to-terracota-600 text-white px-6 py-2.5 rounded-xl hover:shadow-glow hover:scale-105 transition-all font-medium"
        >
          WhatsApp
        </a>
      </div>

      <button
        id="mobile-menu-button"
        class="md:hidden text-gray-700 focus:outline-none"
        aria-label="Abrir menú"
      >
        <svg
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"
          />
        </svg>
      </button>
    </div>

    <!-- Menú móvil (oculto por defecto) -->
    <div id="mobile-menu" class="hidden md:hidden mt-6 pb-4">
      <div class="flex flex-col space-y-3">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class={`font-medium px-5 py-3 rounded-xl transition-all ${
              currentPath === link.href
                ? 'bg-terracota-50 text-terracota-600 font-semibold'
                : 'text-gray-700 hover:bg-gray-50 hover:text-terracota-600'
            }`}
          >
            {link.label}
          </a>
        ))}
        <a
          href={whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-gradient-to-r from-terracota-500 to-terracota-600 text-white px-5 py-3 rounded-xl hover:from-terracota-600 hover:to-terracota-700 transition-all font-semibold text-center shadow-lg"
        >
          Contactar por WhatsApp
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');

  if (menuButton && mobileMenu) {
    menuButton.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }
</script>
