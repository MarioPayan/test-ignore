---
/**
 * Tarjeta de Habitación
 * Componente para mostrar información de una habitación.
 */

interface Props {
  room: {
    id: string;
    name: string;
    description: string;
    features: string[];
    images: string[];
    videos?: string[];
  };
}

const { room } = Astro.props;
const base = import.meta.env.BASE_URL;
const primaryImage = room.images[0] || (room.videos?.[0] ? null : `${base}/images/placeholder.jpg`);
const primaryImageWebP = primaryImage ? primaryImage.replace(/\.(jpg|jpeg|png)$/i, '.webp') : null;
---

<div class="group bg-white rounded-3xl shadow-medium overflow-hidden hover:shadow-xl transition-all duration-500 hover:-translate-y-1">
  <div class="relative h-72 bg-gradient-to-br from-gray-100 to-gray-200 overflow-hidden">
    {primaryImage ? (
      <picture>
        <source srcset={primaryImageWebP} type="image/webp" />
        <img
          src={primaryImage}
          alt={room.name}
          class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
          loading="lazy"
          decoding="async"
          width="600"
          height="288"
        />
      </picture>
    ) : room.videos?.[0] ? (
      <video
        src={room.videos[0]}
        class="w-full h-full object-cover"
        muted
        loop
        playsinline
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center text-gray-400">
        <span class="text-5xl">🏠</span>
      </div>
    )}
    <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
  </div>

  <div class="p-7">
    <h3 class="text-2xl font-display font-bold text-gray-900 mb-3 group-hover:text-terracota-600 transition-colors">
      {room.name}
    </h3>

    <p class="text-gray-600 mb-5 line-clamp-3 leading-relaxed">
      {room.description}
    </p>

    <div class="mb-6">
      <ul class="grid grid-cols-2 gap-3">
        {room.features.slice(0, 4).map((feature) => (
          <li class="text-sm text-gray-700 flex items-center">
            <span class="text-terracota-500 mr-2 text-lg">✓</span>
            {feature}
          </li>
        ))}
      </ul>
    </div>

    <div class="flex gap-3">
      <a
        href={`${base}/habitaciones#${room.id}`}
        class="flex-1 bg-gradient-to-r from-terracota-500 to-terracota-600 hover:from-terracota-600 hover:to-terracota-700 text-white text-center px-5 py-3 rounded-xl transition-all font-semibold hover:shadow-glow hover:scale-105"
      >
        Ver Detalles
      </a>
      <a
        href={`https://wa.me/573012712450?text=Hola! Me interesa la ${room.name}`}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-gradient-to-r from-green-500 to-green-600 hover:from-green-600 hover:to-green-700 text-white px-5 py-3 rounded-xl transition-all font-semibold hover:scale-105 hover:shadow-lg flex items-center justify-center"
        title="Consultar por WhatsApp"
      >
        💬
      </a>
    </div>
  </div>
</div>
