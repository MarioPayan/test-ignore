---
/**
 * Tarjeta de Servicio
 * 
 * Muestra un servicio incluido con icono y descripción.
 * 
 * Props:
 * - icon: Emoji o icono
 * - name: Nombre del servicio
 * - description: Descripción breve
 */

interface Props {
  icon: string;
  name: string;
  description: string;
}

const { icon, name, description } = Astro.props;
---

<div class="group text-center p-8 bg-white rounded-2xl shadow-soft hover:shadow-large transition-all duration-500 hover:-translate-y-2 border border-gray-100">
  <div class="text-6xl mb-4 group-hover:scale-110 transition-transform duration-500">{icon}</div>
  <h3 class="font-bold text-lg text-gray-900 mb-3 group-hover:text-terracota-600 transition-colors">{name}</h3>
  <p class="text-sm text-gray-600 leading-relaxed">{description}</p>
</div>
